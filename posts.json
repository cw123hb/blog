---
layout: null
permalink: /posts.json
---
[
{% assign ordered_pages = site.pages | sort: "path" %}
{% assign separator = "" %}
{% for post in ordered_pages %}
{% if post.path contains "posts/" and post.path contains ".md" %}
{{ separator }}{"slug": {{ post.name | remove: ".md" | jsonify }}, "title": {{ post.title | default: post.name | jsonify }}, "date": {% if post.date %}{{ post.date | date: "%Y-%m-%d" | jsonify }}{% else %}""{% endif %}, "url": {{ post.url | jsonify }}}
{% assign separator = "," %}
{% endif %}
{% endfor %}
]
